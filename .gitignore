*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging / build output
build/
dist/
sdist/
wheels/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# uv / local Python tooling
.python-version.local

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
